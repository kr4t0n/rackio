# Rackio environment configuration — copy to .env and adjust.
# .env is gitignored; never commit real values.

# API/production server port
PORT=8787

# Where board.json lives (default: ./data). In Docker/k8s this should be a
# mounted volume so the layout survives restarts.
# DATA_DIR=data

# Calibre-Web card (optional — card shows a setup hint until these are set).
# The server reads the OPDS catalog with HTTP basic auth using a normal
# Calibre-Web user; credentials never leave the server.
# CALIBRE_BASE_URL=https://calibre.example.com
# CALIBRE_USER=rackio
# CALIBRE_PASSWORD=change-me

# Calendar card (optional): iCal feed URL. Normally set from the card's
# settings; this overrides it for deployment-managed setups.
# CALENDAR_ICS_URL=https://calendar.example.com/feed.ics

# AdGuard card (optional): instance URL + credentials. Normally set from the
# card's settings; these override for deployment-managed setups.
# ADGUARD_BASE_URL=http://192.168.1.2:3000
# ADGUARD_USER=rackio
# ADGUARD_PASSWORD=change-me
