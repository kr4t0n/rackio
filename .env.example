# Rackio environment configuration — copy to .env and adjust.
# .env is gitignored; never commit real values.
#
# Only runtime plumbing lives here. Integration credentials (Calibre,
# calendar, AdGuard, torrent clients) are deliberately NOT configurable
# from the environment: connect each card from its settings UI and the
# server stores the credentials under DATA_DIR (connections.json, 0600).

# API/production server port
PORT=8787

# Bind address — 0.0.0.0 so the LAN/tailnet can reach it.
# HOST=0.0.0.0

# Where board.json, connections.json, and the cover cache live.
# In Docker/k8s this should be a mounted volume.
# DATA_DIR=data
